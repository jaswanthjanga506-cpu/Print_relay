# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database (MongoDB Atlas connection string) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/printrelay?retryWrites=true&w=majority

# ---- Security (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
PICKUP_SECRET=replace-with-a-different-long-random-string

# ---- CORS: exact frontend origins, comma separated (no trailing slash) ----
CLIENT_ORIGINS=http://localhost:5173

# ---- Cookies ----
# Defaults: lax in development, none (cross-site, requires HTTPS) in production.
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ---- Uploads ----
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=500

# ---- Local demo accounts (used only by `npm run seed:demo`) ----
DEMO_SEED_ENABLED=false
ADMIN_NAME=PrintRelay Demo Admin
ADMIN_EMAIL=admin@printrelay.test
ADMIN_PASSWORD=replace-with-a-local-password-at-least-12-characters
DEMO_CUSTOMER_EMAIL=customer@printrelay.test
DEMO_CUSTOMER_PASSWORD=replace-with-a-local-password-at-least-12-characters
DEMO_SHOP_OWNER_EMAIL=owner@printrelay.test
DEMO_SHOP_OWNER_PASSWORD=replace-with-a-local-password-at-least-12-characters
